# Model Gateway Configuration (Local Nemotron / llama.cpp)
MODEL_API_KEY=local
MODEL_BASE_URL=http://127.0.0.1:8080/v1
MODEL_NAME=nemotron

# Vector Database (Qdrant)
VECTOR_DB_URL=http://localhost:6333
VECTOR_COLLECTION=memories
SIMILARITY_METRIC=Cosine

# Embeddings (Local SentenceTransformer)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Persistent Memory Subsystem
MEMORY_ENABLED=true
MEMORY_TOP_K=5
MEMORY_SIMILARITY_THRESHOLD=0.60
MEMORY_DEDUP_THRESHOLD=0.85
MEMORY_DECAY_HALF_LIFE_DAYS=30.0
